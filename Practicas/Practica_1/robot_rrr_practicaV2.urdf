<?xml version="1.0"?>
<robot name="robot">

  <!-- BASE -->
  <link name="base0_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.1"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="black">
        <color rgba="0 0 0 0.5"/>
      </material>
    </visual>
  </link>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25"/>
      <material name="black">
        <color rgba="0 0 0 0.5"/>
      </material>
    </visual>
  </link>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
      <origin xyz="0.15 0 0.0"/>
      <material name="cyan">
        <color rgba="0 1 1 1"/>
      </material>
    </visual>
  </link>

  <link name="arm_link">
    <visual>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
      <origin xyz="0.15 0 0.05"/>
      <material name="magenta">
        <color rgba="1 0 1 1"/>
      </material>
    </visual>
  </link>

  <link name="forearm_link">
    <visual>
      <geometry>
        <box size="0.03 0.2 0.03"/>
      </geometry>
      <origin xyz="0 -0.2 0"/>
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
  </link>

  <!--Descripción de las juntas-->
  <joint name="base_joint" type="fixed"> <!--tipo de junta: revolute, prismatic, fixed-->
    <parent link="base0_link"/>
    <child link="base_link"/>
  </joint>

  <joint name="shoulder_joint" type="revolute"> <!--tipo de junta: revolute, prismatic, fixed-->
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="arm_joint" type="revolute"> <!--tipo de junta: revolute, prismatic, fixed-->
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <origin xyz="0.3 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="forearm_joint" type="prismatic"> <!--tipo de junta: revolute, prismatic, fixed-->
    <parent link="arm_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.15" upper="0" effort="10" velocity="1"/>
    <origin xyz="0.3 0 0.35" rpy="1.57 0 0"/>
  </joint>

</robot>